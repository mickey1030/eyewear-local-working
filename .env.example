# Copy this file to ".env" in the repo root (same folder as package.json) and fill it in.
# ".env" is git-ignored - never commit real secrets.

# --- Database (Neon) --------------------------------------------------------
# Neon dashboard -> Connect -> copy the connection string. It must look like:
#   postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# No quotes, no "psql " prefix. URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Signs the admin cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
# Password for the /admin login page
ADMIN_PASSWORD=change-me

# --- Server -----------------------------------------------------------------
PORT=8080
# Storefront dev server (Vite). The API is proxied at /api.
WEB_PORT=5173
# NODE_ENV is set by the pnpm scripts; you normally don't need it here.
# LOG_LEVEL=info
# Optional: folder for uploaded product images (default: artifacts/api-server/uploads)
# UPLOADS_DIR=uploads
# Optional: extra allowed browser origins, comma separated (only if not using the Vite proxy)
# CORS_ORIGINS=http://localhost:5173
# Set to true only when serving over HTTPS (production behind a TLS proxy)
# COOKIE_SECURE=true
# TRUST_PROXY=true

# --- Frontend build ---------------------------------------------------------
# Public origin used for canonical/OG/sitemap URLs at `pnpm build` time
# VITE_SITE_ORIGIN=https://www.your-domain.com

# --- SEO ----------------------------------------------------------------------
# Public origin used in /sitemap.xml and /robots.txt (set this in production)
# SITE_ORIGIN=https://www.your-domain.com
