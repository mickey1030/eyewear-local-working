{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/require-pnpm.mjs",
    "dev": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/ashraf-monir run dev",
    "dev:all": "pnpm --parallel --filter @workspace/api-server --filter @workspace/ashraf-monir run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:studio": "pnpm --filter @workspace/db run studio",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
